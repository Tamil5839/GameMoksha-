# Copy to .env.local and fill in. Never commit real keys.

# Supabase → Project Settings → API (or the output of `npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon (or publishable) key: safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role (or secret) key: server only. Used to save check-ins so dice can't be forged.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the app, used in magic-link emails. Optional: defaults to the request's host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true = run without Supabase: in-memory data, one-tap demo login and a "next day" button.
# For local development only; data is lost when the server restarts.
DEMO_MODE=false
